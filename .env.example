# Copy to .env (git-ignored) and fill in. Read ONLY by scripts/bootstrap-secrets.sh,
# which turns these into Kubernetes Secrets. Nothing else in the repo reads .env.
#
# The file is sourced by bash, so wrap a value in single quotes if it contains
# spaces or characters like $ ! ` and so on.

# --- store database (MySQL/MariaDB behind WordPress) ---
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# --- WordPress admin login ---
WP_ADMIN_PASSWORD=

# --- gateway database (Postgres) ---
POSTGRES_PASSWORD=

# --- gateway backend ---
# Signs dashboard session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Password of the first admin account, created on first start.
ADMIN_BOOTSTRAP_PASSWORD=
# Encrypts the credentials of upstream MCP servers stored in the gateway database (AES-256-GCM).
# Generate with: openssl rand -hex 32. Back it up: if it is lost the stored credentials cannot be read.
CREDENTIAL_ENC_KEY=
# --- Chat (optional): any OpenAI-compatible chat-completions API ---
# All three go into the gateway-app Secret. Leave them empty to run without chat (the Chat page then
# says it is not set up). Pick a provider whose free tier or local option fits your budget, for example:
#   Gemini : LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   Groq   : LLM_BASE_URL=https://api.groq.com/openai/v1
#   Ollama : LLM_BASE_URL=http://host.k3d.internal:11434/v1   (local, no key needed: any non-empty LLM_API_KEY)
# The model name is whatever that provider calls it (check its docs; names change).
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# --- WooCommerce MCP server ---
# The bearer token the gateway presents to it. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# --- demo MCP servers (charts/platform) ---
# Bearer tokens the gateway presents to them. Generate each with: openssl rand -hex 32
FX_MCP_AUTH_TOKEN=
NOTES_MCP_AUTH_TOKEN=
